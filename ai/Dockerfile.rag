# Docling 2.113 and the CPU Torch wheels below have stable support on Python 3.11.
# Keep torch/torchvision paired; mismatched wheels make the worker image fail to build.
FROM python:3.11-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/models \
    SENTENCE_TRANSFORMERS_HOME=/models

WORKDIR /app

RUN apt-get update \
    && apt-get install --no-install-recommends -y \
      libgl1 \
      libglib2.0-0 \
      libxcb1 \
    && rm -rf /var/lib/apt/lists/*

COPY ai/requirements-rag.txt ./requirements-rag.txt
RUN python -m pip install --no-cache-dir \
      "torch==2.6.0+cpu" \
      "torchvision==0.21.0+cpu" \
      --index-url https://download.pytorch.org/whl/cpu \
    && python -m pip install --no-cache-dir -r requirements-rag.txt

FROM base AS test

COPY ai/requirements-dev.txt ./requirements-dev.txt
RUN python -m pip install --no-cache-dir -r requirements-dev.txt
COPY ai ./ai
COPY backend/app ./backend/app
COPY backend/app/services/safety_guidance.py ./safety_guidance.py
ENV PYTHONPATH=/app:/app/ai
CMD ["python", "-m", "pytest", "-q", "/app/ai/tests"]

FROM base AS runtime

COPY ai/rag_service ./rag_service
COPY ai/preprocessing ./preprocessing
COPY backend/app/services/safety_guidance.py ./safety_guidance.py

EXPOSE 8010

CMD ["python", "-m", "uvicorn", "rag_service.main:app", "--host", "0.0.0.0", "--port", "8010"]
