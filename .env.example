APP_ENV=development
CORS_ORIGINS=http://localhost:3000
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=3000

POSTGRES_DB=safemaint
POSTGRES_USER=safemaint
# 팀원마다 URL-safe 문자(영문, 숫자, -, _)로 된 긴 로컬 비밀번호로 변경하세요.
# POSTGRES_PASSWORD와 DATABASE_URL 안의 비밀번호는 반드시 같아야 합니다.
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://safemaint:change-this-local-password@db:5432/safemaint

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Supertonic 3 TTS (CPU). The model is downloaded into a Docker named volume on first use.
TTS_VOICE=F1
TTS_LANGUAGE=ko
TTS_STEPS=8
MODEL_CACHE_VOLUME_NAME=safemaint_model_cache
