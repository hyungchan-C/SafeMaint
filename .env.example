APP_ENV=development
CORS_ORIGINS=http://localhost:3000
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=3000

POSTGRES_DB=safemaint
POSTGRES_USER=safemaint
# 팀원마다 URL-safe 문자(영문, 숫자, -, _)로 된 긴 로컬 비밀번호로 변경하세요.
# POSTGRES_PASSWORD와 DATABASE_URL 안의 비밀번호는 반드시 같아야 합니다.
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://safemaint:change-this-local-password@db:5432/safemaint

SESSION_EXPIRE_MINUTES=60

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# BGE-M3 RAG 채팅(선택): docker-compose.rag.yml을 함께 사용할 때 적용됩니다.
# RAG DB는 실험 스크립트가 만드는 격리 DB이며 기존 safemaint DB와 분리됩니다.
RAG_DATABASE_NAME=safemaint_rag_test
RAG_MODEL=BAAI/bge-m3
# Blank means all supported document types. Restrict only for a deliberate experiment.
RAG_SOURCE_TYPES=
RAG_DEVICE=cpu
RAG_PORT=8010
RAG_TOP_K=5
RAG_CANDIDATE_K=30
RAG_MAX_CHUNKS_PER_DOCUMENT=2
RAG_MIN_SIMILARITY=0.25
RAG_MIN_KEYWORD_SCORE=0.08
RAG_REQUEST_TIMEOUT_SECONDS=180
DOCUMENT_WORKER_POLL_SECONDS=2
DOCUMENT_WORKER_CHUNK_CHARACTERS=1200
DOCUMENT_WORKER_CHUNK_OVERLAP=150
DOCUMENT_WORKER_MAX_ATTEMPTS=3
DOCUMENT_WORKER_RETRY_DELAY_SECONDS=10
DOCUMENT_WORKER_STALE_AFTER_SECONDS=1800

# OpenAI LLM. Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# GPT-4o-mini now; later point LLM_BASE_URL and model names at the team's
# OpenAI-compatible Qwen3 server without changing application code.
LLM_BASE_URL=
# external: provider may be outside the customer network and requires
# ALLOW_EXTERNAL_LLM=true. local: URL host must be listed in LLM_LOCAL_HOSTS.
LLM_PROVIDER_SCOPE=external
LLM_LOCAL_HOSTS=localhost,127.0.0.1,::1,host.docker.internal,ollama
LLM_ANALYZER_MODEL=gpt-4o-mini
LLM_ANSWER_MODEL=gpt-4o-mini
LLM_REASONING_EFFORT=none
LLM_ANALYZER_MAX_OUTPUT_TOKENS=500
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_OUTPUT_TOKENS=1200
# On-premise default: no question, response, chunk, or PDF content leaves the server.
ALLOW_EXTERNAL_LLM=false

# Qwen3.5-9B text model. Company deployment should point at an internal GPU
# service. Colab is only for temporary development/demo use.
QWEN_ENABLED=false
QWEN_PROVIDER=local
QWEN_SERVICE_URL=http://qwen:8020
QWEN_API_KEY=
QWEN_TIMEOUT_SECONDS=600
QWEN_ALLOW_COMPANY_CONTEXT=false

# Demo override example:
# QWEN_ENABLED=true
# QWEN_PROVIDER=colab
# QWEN_SERVICE_URL=https://your-current-colab-tunnel.ngrok-free.app
# QWEN_API_KEY=shared-demo-token
# QWEN_ALLOW_COMPANY_CONTEXT=true

# Optional team Qwen3.5-9B accident-type LoRA. Enable this through
# docker-compose.qwen.yml; do not point these values at an external service.
QWEN_CLASSIFIER_ENABLED=false
QWEN_CLASSIFIER_URL=
QWEN_CLASSIFIER_TIMEOUT_SECONDS=300
QWEN_DEVICE_MAP=auto
QWEN_ALLOW_REMOTE_CODE=false
QWEN_EAGER_LOAD=true
QWEN_GENERAL_MODEL=qwen3.5:4b
QWEN_LLM_BASE_URL=http://host.docker.internal:11434/v1
QWEN_MODEL_VOLUME_NAME=safemaint_qwen_models

# Optional local-only catalog image analysis service.
VISION_SERVICE_URL=http://vision:8020
VISION_QWEN_MODEL=Qwen/Qwen3-VL-2B-Instruct
VISION_QWEN_MAX_PIXELS=524288
VISION_PADDLE_MODEL=PaddlePaddle/PaddleOCR-VL
VISION_DEVICE=cuda
VISION_PADDLE_DEVICE=cpu
VISION_MAX_NEW_TOKENS=96
VISION_EMBEDDING_MODEL=google/siglip2-base-patch16-naflex
VISION_EMBEDDING_DEVICE=cpu
VISION_LOAD_IN_4BIT=true
VISION_ENABLE_PADDLE=true
VISION_ENABLE_QWEN=true
VISION_CATALOG_MATCH_THRESHOLD=0.55
VISION_ADAPTIVE_CONFIDENCE_THRESHOLD=0.90
VISION_ADAPTIVE_MARGIN_THRESHOLD=0.06
VISION_FALLBACK_CANDIDATE_THRESHOLD=0.78
VISION_IMAGE_MAX_UPLOAD_BYTES=10485760
VISION_IMAGE_MAX_PIXELS=40000000
VISION_PDF_MAX_PAGES=500
VISION_CATALOG_MAX_IMAGES=5000
# Set to 1 only after the models have been downloaded once.
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0

# Local persistent storage used by the worker and offline package tools.
DOCUMENT_STORAGE_DIR=/data/documents
# Manual PDF limit: 200 MiB. Keep DOCLING_MAX_FILE_BYTES equal to this value.
DOCUMENT_MAX_UPLOAD_BYTES=209715200
DOCLING_REQUIRED=true
DOCLING_ALLOW_PYMUPDF_FALLBACK=true
DOCLING_OFFLINE=false
# Set to /models/docling after downloading and transferring offline artifacts.
DOCLING_ARTIFACTS_PATH=
DOCLING_MAX_FILE_BYTES=209715200
DOCLING_MAX_PAGES=500
DOCLING_NUM_THREADS=4
DOCLING_ACCELERATOR_DEVICE=auto
DOCUMENT_WORKER_HEARTBEAT_SECONDS=30
PACKAGE_STORAGE_DIR=/data/packages
PUBLIC_PACKAGE_MAX_BYTES=1073741824
# Ed25519 keys are deployment secrets. Do not commit real keys.
PUBLIC_PACKAGE_PUBLIC_KEY=
PUBLIC_PACKAGE_PRIVATE_KEY=
RAG_EMBEDDING_DIMENSION=1024

# Supertonic 3 TTS (CPU). The model is downloaded into a Docker named volume on first use.
TTS_VOICE=F1
TTS_LANGUAGE=ko
TTS_STEPS=8

# faster-whisper STT (CPU, runs fully local — no external API calls).
STT_MODEL=small
STT_LANGUAGE=ko
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8

# 가상 GPS 근접 판정 반경(m). 실제 GPS 연동 전까지 사용하는 테스트용 목데이터 기준값.
GPS_PROXIMITY_RADIUS_M=30

MODEL_CACHE_VOLUME_NAME=safemaint_model_cache
DOCUMENT_VOLUME_NAME=safemaint_documents
PACKAGE_VOLUME_NAME=safemaint_packages
